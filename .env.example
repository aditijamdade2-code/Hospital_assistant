# Application Environment Configuration

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-secret

# Database
# Default local SQLite: sqlite+aiosqlite:///./hospital_assistant.db
# PostgreSQL: postgresql+asyncpg://hospital_user:hospital_password@localhost:5432/hospital_opd
DATABASE_URL=sqlite+aiosqlite:///./hospital_assistant.db

# LLM Configuration
# Options: "mock" (default, zero external dependencies) or "openai"
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Protocols
PROTOCOLS_DIR=../protocols/examples

# Frontend environment variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/staff
